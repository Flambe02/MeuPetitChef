{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    // DOM is here for the recipe importers, not for a browser: they walk a
    // parsed `Document` that jsdom provides at runtime, and the same code runs
    // unchanged in the app with the browser's own DOMParser.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // Node 22.18+ strips types natively, so the import scripts run as `.ts`
    // with explicit `.ts` specifiers — which is what this flag permits.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "scripts/**/*.ts"]
}
