{
  "name": "meu-petit-chef",
  "private": true,
  "version": "0.9.4",
  "type": "module",
  "description": "Meu Petit Chef — PWA de receitas adaptáveis (equipamentos, objetivos nutricionais, porções).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "npm run build && node scripts/gh-pages-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "typecheck:functions": "tsc -p supabase/functions/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run db:verify && npm run typecheck && npm run typecheck:functions && npm run lint && npm run test && npm run build",
    "db:verify": "node scripts/verify-schema.mjs",
    "db:types": "node scripts/gen-types.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "db:link": "supabase link --project-ref",
    "db:push": "supabase db push",
    "db:push:seed": "supabase db push --include-seed",
    "db:diff": "supabase db diff -f",
    "icons": "node scripts/gen-icons.mjs",
    "recipe:urls": "node scripts/recipe-importers/list-urls.ts",
    "recipe:import": "node scripts/recipe-importers/import-recipe.ts",
    "recipe:import-batch": "node scripts/recipe-importers/import-batch.ts",
    "recipe:adapt": "node scripts/recipe-importers/adapt-recipes.ts",
    "import:recipe": "npm run recipe:import --"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.30.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
