# Build tooling caches
.vite/
*.tsbuildinfo

# Generated PWA artefacts — only the dev-mode service worker/manifest.
# The icon PNGs/ico under public/ are source assets `vite-plugin-pwa` reads,
# not something a build produces: excluding them here meant every "Add to
# Home Screen" icon (and the manifest icons themselves) 404'd on every
# deploy, because git never had them to check out.
dev-dist/

# Maquettes de reference (prototype Claude Design, 32 Mo) — locales seulement
example/

# Journal des imports par lot (npm run recipe:import-batch)
.recipe-imports/

# Liste d URLs generee (npm run recipe:urls)
urls.txt

# Artefacts de session locale (Playwright MCP, config Claude Code)
.playwright-mcp/
.claude/
