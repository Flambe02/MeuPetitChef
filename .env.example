# ---------------------------------------------------------------------------
# Meu Petit Chef — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# Só variáveis com o prefixo VITE_ chegam ao bundle do navegador.
# NUNCA coloque a service_role key aqui: ela é secreta e só vive no servidor.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
VITE_SUPABASE_URL="https://votre-projet.supabase.co"
VITE_SUPABASE_ANON_KEY="votre-cle-anon-publishable"

# Marque / branding (opcional — valores padrão em src/config/brand.ts)
VITE_APP_NAME="Meu Petit Chef"

# Ativa o painel devtools do TanStack Query e logs verbosos
VITE_DEBUG="false"

# ---------------------------------------------------------------------------
# Importação de receitas (npm run recipe:import) — só no servidor.
# Nada aqui pode levar o prefixo VITE_: só essas variáveis chegam ao navegador,
# e a service_role key ignora RLS. Veja docs/recipe-importers.md.
# ---------------------------------------------------------------------------

# Obrigatória para `--save`. Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=""
# Opcional — sobrescreve VITE_SUPABASE_URL nos scripts.
SUPABASE_URL=""

# Opcional — perfil a quem atribuir os imports feitos pela linha de comando.
# Vazio: o import pertence ao catálogo e só editores o enxergam.
RECIPE_IMPORT_USER_ID=""

# Opcional — User-Agent do importador. O padrão já se identifica e dá contato.
RECIPE_IMPORT_USER_AGENT=""

# Segredo compartilhado com a Edge Function adapt-recipe (npm run recipe:adapt).
# O MESMO valor precisa estar em: supabase secrets set RECIPE_ADAPT_TOKEN=...
RECIPE_ADAPT_TOKEN=""
